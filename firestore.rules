rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.isAdmin == true;
    }

    // Profile doc per user, plus the `activeOrderId` lock used to block a
    // second order request until the current one is delivered/cancelled.
    // There is no server to trust here, so the "one active order" invariant
    // (and its atomicity under concurrent requests) is enforced by these
    // rules together with Firestore's own transaction semantics: acquiring
    // the lock is only allowed while it's currently null, and a transaction
    // that reads it as null but loses the race to write is rejected and
    // retried by the client SDK — so at most one create can win.
    match /users/{uid} {
      // The name and WhatsApp the staff coordinates deliveries off can only
      // be changed once a day, so they aren't a moving target mid-order. The
      // fields Google syncs on every sign-in (email, photoUrl) are not
      // rate-limited — only what the customer types.
      function editsRateLimitedFields() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(["displayName", "whatsapp"]);
      }

      function profileCooldownPassed() {
        return resource.data.get("profileUpdatedAt", null) == null ||
          request.time > resource.data.profileUpdatedAt + duration.value(24, 'h');
      }

      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if isSignedIn() && request.auth.uid == uid;

      // Owner: profile fields only, never activeOrderId directly.
      allow update: if isSignedIn() && request.auth.uid == uid &&
        !("activeOrderId" in request.resource.data.diff(resource.data).affectedKeys()) &&
        (!editsRateLimitedFields() || profileCooldownPassed());

      // Owner: acquire the lock, only from unlocked. Treat a blank string the
      // same as unset/null — a stray "" (e.g. from a manual console edit)
      // must not count as an active order. (get()'s default only kicks in
      // when the key is absent, not when it's present but null, so both
      // null and "" have to be checked explicitly.)
      allow update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["activeOrderId"]) &&
        (resource.data.get("activeOrderId", null) == null ||
          resource.data.get("activeOrderId", "") == "") &&
        request.resource.data.activeOrderId is string &&
        request.resource.data.activeOrderId != "";

      // Admin: release the lock (as part of marking an order delivered/cancelled).
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["activeOrderId"]) &&
        request.resource.data.activeOrderId == null;

      // Owner: release their own lock, but only once the order it points at
      // is already finished — which is what lets someone who rejected a price
      // adjustment (cancelling that order) immediately place a new one,
      // without opening a way to dodge the one-active-order rule while an
      // order is still live.
      allow update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["activeOrderId"]) &&
        request.resource.data.activeOrderId == null &&
        resource.data.get("activeOrderId", null) != null &&
        resource.data.get("activeOrderId", "") != "" &&
        get(/databases/$(database)/documents/orders/$(resource.data.activeOrderId)).data.status in ["cancelled", "delivered"];
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      // A pedido is a cart of one or more cards (`items`); we don't validate
      // the shape of each item here (low-stakes internal tool — nothing here
      // moves money), just that it's a non-empty list and the aggregate
      // totals are sane numbers.
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == "pending" &&
        request.resource.data.items is list && request.resource.data.items.size() > 0 &&
        request.resource.data.estimatedSubtotal is number && request.resource.data.estimatedSubtotal > 0;

      // Admins change the status and, when TCGPlayer prices move, the prices
      // themselves: rewriting `items` forces every derived total to be
      // rewritten with it (the app recomputes them from the same pricing
      // config the quote was built with), and the order lands in
      // "priceReview" until the customer approves it.
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "updatedAt", "userEmail", "items", "priceAdjustment",
          "estimatedTaxRate", "estimatedSubtotal", "estimatedTax",
          "estimatedMargin", "estimatedInternationalShipping", "estimatedTotal"
        ]) &&
        request.resource.data.status in
          ["pending", "priceReview", "priceConfirmed", "awaitingPayment",
           "ordered", "shipped", "inTransit", "delivered", "cancelled"];

      // Owner: answer a price adjustment — approve it (clearing the staff to
      // buy) or reject it (cancelling the order). Only ever from priceReview,
      // so this can't be used to revive or re-route an order at any other
      // point of its lifecycle.
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == "priceReview" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt", "priceAdjustment"]) &&
        request.resource.data.status in ["priceConfirmed", "cancelled"];

      allow delete: if false;
    }

    // Admin flags are provisioned manually by the developer in the console.
    match /roles/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // App-wide config, reserved for future settings.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
